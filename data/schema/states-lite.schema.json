{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vadneyk.github.io/internships/data/schema/states-lite.schema.json",
  "title": "States lite",
  "description": "data/states-lite.json: short permit answers for more states. Hand edited. The quote-in-excerpt rule is checked by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "read",
    "note",
    "states"
  ],
  "properties": {
    "read": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "min_age",
          "permit",
          "hours",
          "who_to_ask",
          "phone",
          "url",
          "page_title",
          "quote",
          "source_excerpt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "min_age": {
            "type": "string",
            "minLength": 1
          },
          "permit": {
            "type": "string",
            "minLength": 1
          },
          "hours": {
            "type": "string",
            "minLength": 1
          },
          "who_to_ask": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "page_title": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
