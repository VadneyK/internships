{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vadneyk.github.io/internships/data/schema/employers.schema.json",
  "title": "Employers",
  "description": "data/employers.json: employers and rules for the jobs page. Hand edited. Each employer group must be one of the file's own groups list (checked by tools/validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "read",
    "note",
    "groups",
    "employers",
    "rules"
  ],
  "properties": {
    "read": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "string",
            "minLength": 1
          }
        ],
        "items": false
      }
    },
    "employers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "min_age",
          "age_note",
          "roles",
          "how_to_apply",
          "url",
          "page_title",
          "quote",
          "group",
          "where"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "min_age": {
            "type": "integer",
            "minimum": 0
          },
          "age_note": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "string",
            "minLength": 1
          },
          "how_to_apply": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "page_title": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "food",
              "grocery",
              "fun",
              "rec",
              "sports",
              "local",
              "farm",
              "bc",
              "gig",
              "at18"
            ]
          },
          "where": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caveat": {
            "type": "string",
            "minLength": 1
          },
          "posting_status": {
            "enum": [
              "old"
            ]
          },
          "where_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "where_quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "min_age",
          "age_note",
          "roles",
          "how_to_apply",
          "url",
          "page_title",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "min_age": {
            "type": "integer",
            "minimum": 0
          },
          "age_note": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "string",
            "minLength": 1
          },
          "how_to_apply": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "page_title": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
