{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vadneyk.github.io/internships/data/schema/state-wages.schema.json",
  "title": "State wages",
  "description": "data/state-wages.json: state minimum wage rows. Hand edited. The dollar-figure-in-quote rules are checked by tools/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "read",
    "note",
    "states"
  ],
  "properties": {
    "read": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "wage",
          "youth",
          "effective",
          "url",
          "page_title",
          "quote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "wage": {
            "type": "string",
            "minLength": 1
          },
          "youth": {
            "type": "string",
            "minLength": 1
          },
          "effective": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "page_title": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "below_federal": {
            "type": "boolean"
          },
          "youth_url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "youth_quote": {
            "type": "string",
            "minLength": 1
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
